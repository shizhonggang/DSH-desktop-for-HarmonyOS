      "label": "日历"
    },
    "mail": {
      "bundleName": "com.huawei.hmos.email",
      "abilityName": "EntryAbility",
      "label": "邮件"
    },
    "maps": {
      "bundleName": "com.huawei.hmos.maps.app",
      "abilityName": "EntryAbility",
      "label": "地图"
    },
    "finddevice": {
      "bundleName": "com.huawei.hmos.finddevice",
      "abilityName": "EntryAbility",
      "label": "查找设备"
    },
    "ailife": {
      "bundleName": "com.huawei.hmos.ailife",
      "abilityName": "EntryAbility",
      "label": "智慧生活"
    }
  }
